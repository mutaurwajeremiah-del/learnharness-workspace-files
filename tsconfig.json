{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "../learnharness/node_modules/@types"],
    "paths": {
      "learnharness-plugin-api": ["./.sdk/index.d.ts"],
      "@earendil-works/pi-agent-core": ["../learnharness/node_modules/@earendil-works/pi-agent-core/dist/index.d.ts"],
      "@earendil-works/pi-ai": ["../learnharness/node_modules/@earendil-works/pi-ai/dist/index.d.ts"],
      "typebox": ["../learnharness/node_modules/typebox/build/cjs/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
